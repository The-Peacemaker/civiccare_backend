PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/civiccare

# JWT auth. Use long random strings in production.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Sign-In (optional). Leave empty to disable /api/auth/google.
GOOGLE_CLIENT_ID=

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Development only: allows x-user-id header (or a shared dev guest)
# so the API can be tested without a token. NEVER enable in production.
ALLOW_DEV_AUTH=true
