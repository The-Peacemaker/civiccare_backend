{
  "info": {
    "name": "CivicCare API v2",
    "description": "Full CivicCare API: JWT auth, anonymous reports, communities, resources, notifications, stats and uploads. Run the Auth folder first; tokens are saved automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "complaintId", "value": "" },
    { "key": "communityId", "value": "" },
    { "key": "resourceId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "item": [
    {
      "name": "0 - Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Citizen\",\n  \"email\": \"citizen@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@civiccare.local\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.tokens?.accessToken) {",
                  "  pm.collectionVariables.set('adminAccessToken', j.data.tokens.accessToken);",
                  "  pm.collectionVariables.set('accessToken', j.data.tokens.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (citizen)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.tokens?.accessToken) pm.collectionVariables.set('accessToken', j.data.tokens.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Guest session",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/guest" }
        },
        {
          "name": "Refresh tokens",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<paste refreshToken>\"\n}" }
          }
        },
        {
          "name": "Current user",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get my profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/me" }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/users/me",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"John C.\",\n  \"avatarUrl\": \"\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Complaints",
      "item": [
        {
          "name": "Create complaint",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/complaints",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Pothole on MG Road\",\n  \"description\": \"Large pothole causing accidents near bus stop\",\n  \"category\": \"pothole\",\n  \"location\": \"MG Road, Kochi\",\n  \"coords\": { \"lat\": 9.9312, \"lng\": 76.2673 },\n  \"isAnonymous\": true,\n  \"imageUrls\": []\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.id) pm.collectionVariables.set('complaintId', j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List feed",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/complaints?limit=10&sort=latest" }
        },
        {
          "name": "Filter + search",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/complaints?status=in-progress&category=water&q=road" }
        },
        {
          "name": "Get complaint",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/complaints/{{complaintId}}" }
        },
        {
          "name": "Share",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/complaints/{{complaintId}}/share" }
        },
        {
          "name": "Upvote toggle",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/complaints/{{complaintId}}/upvote" }
        },
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/complaints/{{complaintId}}/comments",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"body\": \"Same issue near the signal.\",\n  \"isAnonymous\": true\n}" }
          }
        },
        {
          "name": "List comments",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/complaints/{{complaintId}}/comments" }
        },
        {
          "name": "Update status (admin)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/complaints/{{complaintId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"in-progress\",\n  \"priority\": \"high\",\n  \"note\": \"Assigned to field team\"\n}" }
          },
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{adminAccessToken}}" }]
          }
        },
        {
          "name": "Status history",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/complaints/{{complaintId}}/history" }
        },
        {
          "name": "Delete (admin)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/complaints/{{complaintId}}" },
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{adminAccessToken}}" }]
          }
        },
        {
          "name": "Validation fail demo",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/complaints",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"missing title and location\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Communities",
      "item": [
        {
          "name": "List communities",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/communities" }
        },
        {
          "name": "Create community",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/communities",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MG Road Neighbours\",\n  \"description\": \"Residents fixing local issues together.\",\n  \"category\": \"environment\",\n  \"visibility\": \"public\",\n  \"location\": \"MG Road, Kochi\",\n  \"district\": \"Ernakulam\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.id) pm.collectionVariables.set('communityId', j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get community",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/communities/{{communityId}}" }
        },
        {
          "name": "Update community",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/communities/{{communityId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated description\",\n  \"visibility\": \"private\"\n}" }
          }
        },
        {
          "name": "Join / leave",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/communities/{{communityId}}/join" }
        },
        {
          "name": "Delete community",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/communities/{{communityId}}" }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "List resources",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/resources" }
        },
        {
          "name": "Create resource (staff)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/resources",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Water Authority Helpline\",\n  \"description\": \"Report pipe leaks and supply issues.\",\n  \"category\": \"water\",\n  \"type\": \"contact\",\n  \"phone\": \"0471-2331111\",\n  \"district\": \"Ernakulam\"\n}"
            }
          },
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{adminAccessToken}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.id) pm.collectionVariables.set('resourceId', j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update resource",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/resources/{{resourceId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Water Authority Helpline (24x7)\"\n}" }
          },
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{adminAccessToken}}" }]
          }
        },
        {
          "name": "Delete resource",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/resources/{{resourceId}}" },
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{adminAccessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications?unread=true" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.items?.[0]?.id) pm.collectionVariables.set('notificationId', j.items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark one read",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read" }
        },
        {
          "name": "Mark all read",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/notifications/read-all" }
        },
        {
          "name": "Delete one",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/notifications/{{notificationId}}" }
        },
        {
          "name": "Clear all",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/notifications" }
        }
      ]
    },
    {
      "name": "Stats + Map",
      "item": [
        {
          "name": "Overview",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/stats/overview" }
        },
        {
          "name": "Engagement",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/stats/engagement" }
        },
        {
          "name": "Districts",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/stats/districts" }
        },
        {
          "name": "Map pins",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/map/pins" }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload image",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/uploads",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "photo", "type": "file", "src": "" }]
            }
          }
        }
      ]
    }
  ]
}
